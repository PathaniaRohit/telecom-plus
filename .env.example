# Copy to .env.local (gitignored).

# Where the contact form POSTs its JSON payload (a mail relay, CRM webhook,
# Zapier/Make hook, etc.). Server-only. Without it, production submissions are
# rejected with a "please call or email" message rather than silently dropped.
CONTACT_WEBHOOK_URL=

# Canonical public origin, used for absolute URLs in metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
